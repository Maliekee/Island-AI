<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>IslandAI</AssemblyName>
    <!-- which official site the badge's menu opens: Shared/TitleBadge.cs -->
    <DefineConstants>$(DefineConstants);ISLAND_AI</DefineConstants>
    <RootNamespace>IslandAI</RootNamespace>
    <Version>0.2.6</Version>
    <LangVersion>latest</LangVersion>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Mad Island</GameDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Shared SOURCE compiled into this DLL: the mods share code, not an assembly -->
    <Compile Include="..\Shared\PatchCensus.cs" Link="Shared\PatchCensus.cs" />
    <Compile Include="..\Shared\TitleBadge.cs" Link="Shared\TitleBadge.cs" />
    <Compile Include="..\Shared\FreeModeGate.cs" Link="Shared\FreeModeGate.cs" />
    <Compile Include="..\Shared\Loc.cs" Link="Shared\Loc.cs" />
    <!-- the mod icon, shown on the title screen by Shared/TitleBadge.cs -->
    <EmbeddedResource Include="icon.png" LogicalName="IslandAI.icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Mad Island_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- -p:NoDeploy=true builds without touching the game folder (release builds, or a running game
       that has the plugin DLL locked) -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(NoDeploy)' != 'true'">
    <!-- in its own folder, as the release zips lay it out, with Localization\ beside it
         (Forgejo #19). Its old place, loose in plugins\, is cleared: a copy left there would
         be a second Island AI for the chainloader. A running game locks that copy; the
         build then warns, and the next build after the game exits removes it. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\IslandAI" />
    <Delete Files="$(GameDir)\BepInEx\plugins\IslandAI.dll" ContinueOnError="WarnAndContinue" />
    <!-- the strings.txt per language beside the DLL, where Shared/Loc.cs looks -->
    <ItemGroup>
      <LocalizationFile Include="Localization\**\*.txt;Localization\**\*.tsv" />
    </ItemGroup>
    <Copy SourceFiles="@(LocalizationFile)"
          DestinationFiles="@(LocalizationFile->'$(GameDir)\BepInEx\plugins\IslandAI\Localization\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
