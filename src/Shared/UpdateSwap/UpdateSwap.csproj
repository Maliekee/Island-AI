<Project Sdk="Microsoft.NET.Sdk">

  <!-- The preloader step of the in-game update (Patcher.cs). It ships inside the mods as an
       embedded resource, not as a file of its own, so the zips and the installer stay as they
       are. The number in the name is UpdateDisk.Format. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>IslandUpdateSwap1</AssemblyName>
    <RootNamespace>Shared</RootNamespace>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Mad Island</GameDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Patcher.cs" />
    <Compile Include="UpdateDisk.cs" />
    <Compile Include="UpdateRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(GameDir)\BepInEx\core\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
